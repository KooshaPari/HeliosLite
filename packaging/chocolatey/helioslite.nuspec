<?xml version="1.0" encoding="utf-8"?>
<!--
  Chocolatey package for HeliosLite. Renamed from "forge" (upstream
  tailcallhq/forgecode fork). Install via:
    choco install helioslite -s https://chocolatey.org/api/v2/

  Note: the source flag is written as `-s` rather than its long form because
  XML comments may not contain a double hyphen.

  The download URL and SHA-256 live in tools/chocolateyinstall.ps1, which is
  where Chocolatey expects them. `publishDate` is intentionally absent: the
  Chocolatey server stamps it at push time, and a hand-written value (or a
  placeholder) only misreports the publication date.

  See docs/NOTICE.md for fork attribution and CHANGELOG.md for the
  upstream-merging history.
-->
<package id="helioslite" version="2.13.21-h.0.2.7" publisher="KooshaPari">
  <metadata>
    <id>helioslite</id>
    <title>HeliosLite</title>
    <version>2.13.21-h.0.2.7</version>
    <authors>KooshaPari (Phenotype.)</authors>
    <owners>kooshapari</owners>
    <projectUrl>https://github.com/KooshaPari/HeliosLite</projectUrl>
    <projectSourceUrl>https://github.com/KooshaPari/HeliosLite</projectSourceUrl>
    <packageSourceUrl>https://github.com/KooshaPari/HeliosLite</packageSourceUrl>
    <docsUrl>https://github.com/KooshaPari/HeliosLite#readme</docsUrl>
    <bugTrackerUrl>https://github.com/KooshaPari/HeliosLite/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/KooshaPari/HeliosLite/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>AI coding agent CLI. Fork of tailcallhq/forgecode.</summary>
    <description>
HeliosLite is the renamed CLI of the KooshaPari/forgecode fork.

Upstream is tailcallhq/forgecode (MIT). The KooshaPari fork ships
additive renames, AI-DD/HITL-less operating modes, and an in-house
update chain that resolves GitHub releases for `KooshaPari/HeliosLite`
with a fallback to `KooshaPari/forgecode`.

The CLI installs as `helioslite`; the legacy `forge` command is kept as
an alias shim. The legacy binaries continue to publish to npm/crates.io
under their existing names while `helioslite` becomes canonical.
    </description>
    <copyright>(c) KooshaPari 2024-2026</copyright>
    <tags>cli ai coding agent rust cross-platform foss admin</tags>
    <!-- The MSVC target links the Visual C++ runtime dynamically, so the
         redistributable is a genuine requirement rather than a precaution. -->
    <dependencies>
      <dependency id="vcredist140" version="[14.0,)" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
